# ---------------- Paredes decoradas (faixa superior das salas da Prancha) ----------------
for scene, b, frac in zip(['lab', 'biblioteca', 'oficina', 'correio', 'farol'],
                          [(628, 23, 184, 247), (627, 307, 181, 218), (626, 561, 182, 246), (627, 839, 182, 245), (627, 1121, 182, 223)],
