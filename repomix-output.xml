d.text((PAD, 56), 'Densidade: 64 px = 1 tile. Fundo transparente real. Mesma luz (cima-esquerda) e paleta das folhas atuais.', font=F_SMALL, fill=(90, 102, 118))
y = 96
for title, groups, want, bw, bh in blocks:
