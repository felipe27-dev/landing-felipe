# ---- PrÃ©dios (tamanho nativo) ----

for name, box in {'lab': (72, 1028, 259, 1190), 'biblioteca': (75, 1191, 261, 1334), 'oficina': (77, 1339, 261, 1530),

                  'correio': (285, 1060, 478, 1259), 'farol': (271, 1286, 485, 1385)}.items():

