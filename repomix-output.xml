            for yy in range(0, f.height, 8):
                for xx in range(0, f.width, 8):
                    if (xx // 8 + yy // 8) % 2: d.rectangle((cx + xx, y + 64 + yy, cx + min(xx + 8, f.width) - 1, y + 64 + min(yy + 8, f.height) - 1), fill=(232, 236, 242))
            img.alpha_composite(f, (cx, y + 64))
